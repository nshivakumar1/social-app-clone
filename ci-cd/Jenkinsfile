pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        ECR_REGISTRY    = '297997106614.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPOSITORY  = 'social-app-clone'
        AWS_REGION      = 'us-east-1'
        ECS_CLUSTER     = 'social-app-clone'
        ECS_SERVICE     = 'social-app-clone'
        EKS_CLUSTER     = 'social-app-eks'
        IMAGE_TAG       = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    checkout scm
                    env.COMMIT_SHA     = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.COMMIT_MESSAGE = sh(script: 'git log -1 --pretty=format:%s', returnStdout: true).trim()
                    env.AUTHOR         = sh(script: 'git log -1 --pretty=format:%an', returnStdout: true).trim()
                    echo "Commit: ${env.COMMIT_SHA} by ${env.AUTHOR} — ${env.COMMIT_MESSAGE}"

                    // Capture current task def for rollback
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]]) {
                        env.PREVIOUS_TASK_DEF = sh(
                            script: "aws ecs describe-services --cluster ${ECS_CLUSTER} --services ${ECS_SERVICE} --region ${AWS_REGION} --query 'services[0].taskDefinition' --output text 2>/dev/null || echo 'none'",
                            returnStdout: true
                        ).trim()
                        echo "Rollback target: ${env.PREVIOUS_TASK_DEF}"
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh 'npm ci'
                    sh 'npm test'
                }
            }
        }

        stage('Code Quality') {
            steps {
                dir('app') {
                    sh 'npm run lint'
                    sh 'npm audit --audit-level=moderate'

                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]]) {
                        script {
                            try {
                                def sonarToken = sh(
                                    script: 'aws ssm get-parameter --name "/social-app/sonar/token" --with-decryption --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"',
                                    returnStdout: true
                                ).trim()
                                def sonarHost = sh(
                                    script: 'aws ssm get-parameter --name "/social-app/sonar/host" --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"',
                                    returnStdout: true
                                ).trim()

                                if (sonarToken != 'not-configured' && sonarHost != 'not-configured') {
                                    sh """
                                        sonar-scanner \
                                          -Dsonar.projectKey=social-app-clone \
                                          -Dsonar.sources=. \
                                          -Dsonar.host.url=${sonarHost} \
                                          -Dsonar.login=${sonarToken}
                                    """
                                } else {
                                    echo 'SonarQube not configured — skipping'
                                }
                            } catch (Exception e) {
                                echo "SonarQube analysis failed: ${e.getMessage()}"
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh "docker build --platform linux/amd64 -t ${ECR_REPOSITORY}:${IMAGE_TAG} ."
                    sh "docker tag ${ECR_REPOSITORY}:${IMAGE_TAG} ${ECR_REPOSITORY}:${env.COMMIT_SHA}"
                    sh "docker tag ${ECR_REPOSITORY}:${IMAGE_TAG} ${ECR_REPOSITORY}:latest"
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    sh """
                        docker run --rm \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          aquasec/trivy:latest image \
                          --exit-code 1 \
                          --severity CRITICAL,HIGH \
                          --no-progress \
                          ${ECR_REPOSITORY}:${IMAGE_TAG} || true
                    """
                    // || true so high-sev findings don't block pipeline on first run;
                    // remove || true once baseline is clean
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                    sh "docker tag ${ECR_REPOSITORY}:${IMAGE_TAG}       ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    sh "docker tag ${ECR_REPOSITORY}:${env.COMMIT_SHA}  ${ECR_REGISTRY}/${ECR_REPOSITORY}:${env.COMMIT_SHA}"
                    sh "docker tag ${ECR_REPOSITORY}:latest              ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${env.COMMIT_SHA}"
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh "aws ecs update-service --cluster ${ECS_CLUSTER} --service ${ECS_SERVICE} --force-new-deployment --region ${AWS_REGION}"
                    sh "aws ecs wait services-stable --cluster ${ECS_CLUSTER} --services ${ECS_SERVICE} --region ${AWS_REGION} --cli-read-timeout 300 --cli-connect-timeout 60"
                }
            }
        }

        stage('Health Check') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        def ecsUrl = sh(
                            script: 'aws ssm get-parameter --name "/social-app/ecs/url" --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"',
                            returnStdout: true
                        ).trim()

                        if (ecsUrl != 'not-configured') {
                            def passed = false
                            for (int i = 0; i < 12; i++) {
                                def status = sh(
                                    script: "curl -s -o /dev/null -w '%{http_code}' ${ecsUrl}/health || echo '000'",
                                    returnStdout: true
                                ).trim()
                                if (status == '200') {
                                    echo "Health check passed on attempt ${i + 1}"
                                    passed = true
                                    break
                                }
                                echo "Attempt ${i + 1}: HTTP ${status} — waiting 10s"
                                if (i < 11) sleep(10)
                            }
                            if (!passed) {
                                error("Health check failed after 120s")
                            }
                        } else {
                            echo 'ECS URL not in SSM — skipping health check'
                        }
                    }
                }
            }
        }

        stage('Update GitOps Manifests') {
            steps {
                script {
                    try {
                        sh """
                            sed -i 's|image: .*social-app-clone:.*|image: ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}|g' \
                              infrastructure/k8s-manifests/deployment.yaml
                        """
                        sh 'git config user.email jenkins@social-app.com'
                        sh 'git config user.name "Jenkins GitOps"'
                        sh 'git add infrastructure/k8s-manifests/deployment.yaml'
                        sh "git diff --staged --quiet || git commit -m 'GitOps: Update image to ${IMAGE_TAG} [skip ci]'"
                        sh 'git push origin main || echo "Push failed — may already be up to date"'
                    } catch (Exception e) {
                        echo "GitOps update failed: ${e.getMessage()} — continuing"
                    }
                }
            }
        }

        stage('ArgoCD Sync') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        try {
                            sh "aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER}"
                            def kubectlWorks = sh(script: 'kubectl get nodes', returnStatus: true) == 0
                            if (kubectlWorks) {
                                sh """
kubectl apply -f - << 'EOF'
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: social-app-clone
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/nshivakumar1/social-app-clone.git
    targetRevision: main
    path: infrastructure/k8s-manifests
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    retry:
      limit: 3
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
EOF
                                """
                                sh 'kubectl patch app social-app-clone -n argocd -p \'{"operation":{"initiatedBy":{"username":"jenkins"},"sync":{"syncStrategy":{"hook":{}}}}}\' --type merge || true'
                            }
                        } catch (Exception e) {
                            echo "ArgoCD sync failed: ${e.getMessage()}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh "docker rmi ${ECR_REPOSITORY}:${IMAGE_TAG} || true"
                sh "docker rmi ${ECR_REPOSITORY}:${env.COMMIT_SHA} || true"
                sh "docker rmi ${ECR_REPOSITORY}:latest || true"
                cleanWs()
            }
        }

        success {
            script {
                sendNotifications('success')
            }
        }

        failure {
            script {
                // Rollback ECS to last stable task definition
                if (env.PREVIOUS_TASK_DEF && env.PREVIOUS_TASK_DEF != 'none') {
                    try {
                        withCredentials([[
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-credentials',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]]) {
                            sh "aws ecs update-service --cluster ${ECS_CLUSTER} --service ${ECS_SERVICE} --task-definition ${env.PREVIOUS_TASK_DEF} --region ${AWS_REGION}"
                            echo "Rolled back to ${env.PREVIOUS_TASK_DEF}"
                        }
                    } catch (Exception e) {
                        echo "Rollback failed: ${e.getMessage()}"
                    }
                }
                sendNotifications('failure')
            }
        }
    }
}

def sendNotifications(String status) {
    withCredentials([[
        $class: 'AmazonWebServicesCredentialsBinding',
        credentialsId: 'aws-credentials',
        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
    ]]) {
        // Slack
        try {
            def slackWebhook = sh(
                script: 'aws ssm get-parameter --name "/social-app/slack/webhook-url" --with-decryption --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"',
                returnStdout: true
            ).trim()

            if (slackWebhook != 'not-configured') {
                def message = status == 'success'
                    ? "Deployment Successful! Build #${BUILD_NUMBER} — ${env.COMMIT_MESSAGE}"
                    : "Deployment Failed! Build #${BUILD_NUMBER} — ${env.COMMIT_MESSAGE} — ${BUILD_URL}console"
                sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"text\":\"${message}\"}' '${slackWebhook}'"
            }
        } catch (Exception e) {
            echo "Slack notification failed: ${e.getMessage()}"
        }

        // Jira — use temp file to avoid shell injection on commit message content
        try {
            def jiraHost     = 'infinityloop.atlassian.net'
            def jiraUsername = sh(script: 'aws ssm get-parameter --name "/social-app/jira/username" --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"', returnStdout: true).trim()
            def jiraToken    = sh(script: 'aws ssm get-parameter --name "/social-app/jira/api-token" --with-decryption --query "Parameter.Value" --output text 2>/dev/null || echo "not-configured"', returnStdout: true).trim()

            if (jiraUsername != 'not-configured' && jiraToken != 'not-configured') {
                def summary     = status == 'success' ? "Deployment Successful - Build #${BUILD_NUMBER}" : "Deployment Failed - Build #${BUILD_NUMBER}"
                def description = status == 'success'
                    ? "Build #${BUILD_NUMBER} deployed successfully. Commit: ${env.COMMIT_SHA}. Author: ${env.AUTHOR}."
                    : "Build #${BUILD_NUMBER} failed. Commit: ${env.COMMIT_SHA}. Author: ${env.AUTHOR}. Logs: ${BUILD_URL}console"
                def priority    = status == 'success' ? 'Medium' : 'High'

                // Use Groovy JSON to safely escape content — no shell injection risk
                def payload = groovy.json.JsonOutput.toJson([
                    fields: [
                        project    : [key: 'SAD'],
                        summary    : summary,
                        description: description,
                        issuetype  : [name: 'Task'],
                        priority   : [name: priority]
                    ]
                ])

                writeFile file: '/tmp/jira-payload.json', text: payload

                def resp = sh(
                    script: """
                        curl -s -X POST \
                          -u '${jiraUsername}:${jiraToken}' \
                          -H 'Content-Type: application/json' \
                          -d @/tmp/jira-payload.json \
                          -w '\\nHTTP_STATUS:%{http_code}' \
                          'https://${jiraHost}/rest/api/2/issue/' 2>/dev/null
                    """,
                    returnStdout: true
                ).trim()

                if (resp.contains('HTTP_STATUS:201')) {
                    echo "Jira issue created"
                } else {
                    echo "Jira issue creation returned: ${resp}"
                }

                sh 'rm -f /tmp/jira-payload.json'
            }
        } catch (Exception e) {
            echo "Jira notification failed: ${e.getMessage()}"
        }
    }
}
